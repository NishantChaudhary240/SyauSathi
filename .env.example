NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_DATABASE=syausathi

# Generate separate secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-a-generated-secret-before-running
OTP_HASH_SECRET=replace-with-a-different-generated-secret-before-running

# Development OTPs are logged only outside production.
OTP_DELIVERY_PROVIDER=development

# Reserved for the future Sparrow delivery provider.
SPARROW_SMS_TOKEN=
SPARROW_SMS_SENDER=
