PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_DATABASE=syausathi
DB_SYNCHRONIZE=false

# Replace this placeholder with a unique value from: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-a-generated-secret-before-running
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# The OTP module currently uses the development delivery provider.
OTP_DELIVERY_PROVIDER=development

# Configure these only when the Sparrow provider is implemented and enabled.
SPARROW_SMS_TOKEN=
SPARROW_SMS_SENDER=
